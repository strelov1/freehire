      "id": "component.form-field",
      "type": "component",
      "name": "FormField",
      "description": "Label + error + hint wrapper with auto-generated id and required indicator.",
      "source": {
        "file": "../../src/form-field.svelte"
      },
      "props": [
        {
          "name": "label",
          "type": "string"
        },
