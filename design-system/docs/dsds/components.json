          "type": "boolean",
          "default": false
        },
        {
          "name": "class",
          "type": "string"
        },
        {
          "name": "children",
          "type": "Snippet<[{ id: string; describedBy: string | undefined; required: boolean; invalid: boolean }]>",
          "required": true,
          "description": "The field owns the label and the message and hands the control everything it needs to announce itself — render it as {@render children({ id, describedBy, required, invalid })}."
        }
      ],
      "stories": [
