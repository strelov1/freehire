{
  "$schema": "https://designsystemds.org/schema/component.json",
  "entities": [
    {
      "id": "component.button",
      "type": "component",
      "name": "Button",
      "description": "Action button with variant (primary/secondary/outline/ghost/destructive) and size (sm/md/lg/icon) props. Supports href for link rendering.",
      "source": {
        "file": "../../src/button.svelte"
      },
      "props": [
        {
          "name": "variant",
          "type": "ButtonVariant",
          "default": "secondary",
          "values": [
            "primary",
            "cta",
            "secondary",
            "outline",
            "ghost",
            "destructive"
          ],
          "description": "destructive is filled, for the action that cannot be undone; a ghost button with destructive text is the right weight for reversible ones."
        },
        {
          "name": "size",
          "type": "ButtonSize",
          "default": "md",
          "values": [
            "sm",
            "md",
            "lg",
            "icon"
          ]
        },
        {
          "name": "href",
          "type": "string",
          "default": "undefined",
          "description": "If set, renders an <a> instead of a <button>."
        },
        {
          "name": "target",
          "type": "string",
          "default": "undefined",
          "description": "Anchor target; only meaningful alongside href."
        },
        {
          "name": "rel",
          "type": "string",
          "default": "undefined",
          "description": "Left unset, target=\"_blank\" still gets rel=\"noopener noreferrer\" — the component fills the reverse-tabnabbing default in so no call site has to. Passing rel yourself replaces it, including that default."
        },
        {
          "name": "class",
          "type": "string",
          "default": "undefined"
        },
        {
          "name": "children",
          "type": "Snippet",
          "required": true
        },
        {
          "name": "...rest",
          "type": "HTMLButtonAttributes & HTMLAnchorAttributes",
          "description": "Forwarded to the rendered <button> or <a> — disabled, type, onclick, aria-*."
        }
      ],
      "stories": [
        {
          "file": "../../src/button.stories.ts"
        },
        {
          "file": "../../src/button-icon.stories.ts"
        }
      ]
    },
    {
      "id": "component.badge",
      "type": "component",
      "name": "Badge",
      "description": "Small status label with variant (secondary/outline/brand/missing).",
      "source": {
        "file": "../../src/badge.svelte"
      },
      "props": [
        {
          "name": "variant",
          "type": "BadgeVariant",
          "default": "secondary",
          "values": [
            "secondary",
            "outline",
            "brand",
            "missing"
          ]
        },
        {
          "name": "class",
          "type": "string"
        },
        {
          "name": "children",
          "type": "Snippet",
          "required": true
        }
      ],
      "stories": [
        {
          "file": "../../src/badge.stories.ts"
        }
      ]
    },
    {
      "id": "component.input",
      "type": "component",
      "name": "Input",
      "description": "Styled text input with bindable value, focus ring, and dark-mode support.",
      "source": {
        "file": "../../src/input.svelte"
      },
      "props": [
        {
          "name": "value",
          "type": "string",
          "bindable": true
        },
        {
          "name": "class",
          "type": "string"
        },
        {
          "name": "...rest",
          "type": "HTMLInputAttributes",
          "description": "Spread onto the <input>, so type, placeholder, disabled and the rest go straight through."
        }
      ],
      "stories": [
        {
          "file": "../../src/input.stories.ts"
        }
      ]
    },
    {
      "id": "component.card",
      "type": "component",
      "name": "Card",
      "description": "Surface container with border, bg-card, and shadow-sm.",
      "source": {
        "file": "../../src/card.svelte"
      },
      "props": [
        {
          "name": "class",
          "type": "string"
        },
        {
          "name": "children",
          "type": "Snippet",
          "required": true
        }
      ],
      "stories": [
        {
          "file": "../../src/card.stories.ts"
        }
      ]
    },
    {
      "id": "component.dialog",
      "type": "component",
      "name": "Dialog",
      "description": "Native <dialog> opened with showModal(), so the browser supplies the top layer, focus trap, inert background and Escape-to-close. Uses a compact content-sized card on every viewport with screen-edge margins and bounded scrolling. Adds the backdrop styling, a scroll lock and an in-card close button with reserved space even in title-less descriptions. A description-only dialog uses that text as its accessible name. Stacks without a z-index — the top layer is above every one of them.",
      "source": {
        "file": "../../src/dialog.svelte"
      },
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "bindable": true,
          "default": false
        },
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "dismissible",
          "type": "boolean",
          "default": true,
          "description": "Whether the caller may close it. False holds the dialog while an irreversible request is in flight — Escape, the backdrop and the close button go away together."
        },
        {
          "name": "class",
          "type": "string"
        },
        {
          "name": "children",
          "type": "Snippet",
          "required": true
        }
      ],
      "stories": [
        {
          "file": "../../src/dialog.stories.ts"
        }
      ]
    },
    {
      "id": "component.confirm-dialog",
      "type": "component",
      "name": "ConfirmDialog",
      "description": "A Dialog preset for the confirm-then-act flow that used to be window.confirm(): title, optional description, Cancel and confirm buttons. onConfirm may be async and may throw — the dialog holds itself non-dismissible and disables both buttons while it runs, then either closes (resolved) or shows the thrown message in place and re-enables (rejected).",
      "source": {
        "file": "../../src/confirm-dialog.svelte"
      },
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "bindable": true,
          "default": false
        },
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "confirmLabel",
          "type": "string",
          "default": "Confirm"
        },
        {
          "name": "cancelLabel",
          "type": "string",
          "default": "Cancel"
        },
        {
          "name": "variant",
          "type": "ButtonVariant",
          "default": "cta",
          "description": "Passed straight to the confirm button. Reserve 'destructive' the way Button itself does — the action that destroys something and cannot be undone, not every removal."
        },
        {
          "name": "onConfirm",
          "type": "() => void | Promise<void>",
          "required": true
        },
        {
          "name": "children",
          "type": "Snippet"
        }
      ],
      "stories": [
        {
          "file": "../../src/confirm-dialog.stories.ts"
        }
      ]
    },
    {
      "id": "component.notice-dialog",
      "type": "component",
      "name": "NoticeDialog",
      "description": "A Dialog preset for the replacement of window.alert(): title, optional description, one OK button. Purely informational — no busy/error handling like ConfirmDialog, since there is nothing to await.",
      "source": {
        "file": "../../src/notice-dialog.svelte"
      },
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "bindable": true,
          "default": false
        },
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "confirmLabel",
          "type": "string",
          "default": "OK"
        },
        {
          "name": "children",
          "type": "Snippet"
        }
      ],
      "stories": [
        {
          "file": "../../src/notice-dialog.stories.ts"
        }
      ]
    },
    {
      "id": "component.tabs",
      "type": "component",
      "name": "Tabs",
      "description": "Tab list with arrow-key navigation and ARIA roles. Active tab styled via tailwind-variants, with color-only transitions that respect reduced motion.",
      "source": {
        "file": "../../src/tabs.svelte"
      },
      "props": [
        {
          "name": "value",
          "type": "string",
          "bindable": true
        },
        {
          "name": "tabs",
          "type": "{ value: string; label: string }[]",
          "required": true
        },
        {
          "name": "class",
          "type": "string"
        },
        {
          "name": "children",
          "type": "Snippet",
          "required": true
        }
      ],
      "stories": [
        {
          "file": "../../src/tabs.stories.ts"
        }
      ]
    },
    {
      "id": "component.tooltip",
      "type": "component",
      "name": "Tooltip",
      "description": "Hover/focus tooltip with 4 positions (top/right/bottom/left).",
      "source": {
        "file": "../../src/tooltip.svelte"
      },
      "props": [
        {
          "name": "content",
          "type": "Snippet",
          "required": true
        },
        {
          "name": "side",
          "type": "'top' | 'right' | 'bottom' | 'left'",
          "default": "top"
        },
        {
          "name": "class",
          "type": "string"
        },
        {
          "name": "children",
          "type": "Snippet",
          "required": true
        }
      ],
      "stories": [
        {
          "file": "../../src/tooltip.stories.ts"
        }
      ]
    },
    {
      "id": "component.alert",
      "type": "component",
      "name": "Alert",
      "description": "Inline alert with default/destructive/brand variants.",
      "source": {
        "file": "../../src/alert.svelte"
      },
      "props": [
        {
          "name": "variant",
          "type": "AlertVariant",
          "default": "default",
          "values": [
            "default",
            "destructive",
            "brand"
          ]
        },
        {
          "name": "live",
          "type": "boolean",
          "default": true,
          "description": "Whether the destructive variant is an assertive live region (role=\"alert\"). False for a caller that already voices the failure through a shared announcer, so it is not read twice; the box stays readable in browse mode."
        },
        {
          "name": "class",
          "type": "string"
        },
        {
          "name": "children",
          "type": "Snippet",
          "required": true
        }
      ],
      "stories": [
        {
          "file": "../../src/alert.stories.ts"
        }
      ]
    },
    {
      "id": "component.chip",
      "type": "component",
      "name": "Chip",
