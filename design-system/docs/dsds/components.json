    {
      "id": "component.dialog",
      "type": "component",
      "name": "Dialog",
      "description": "Native <dialog> opened with showModal(), so the browser supplies the top layer, focus trap, inert background and Escape-to-close. Adds the backdrop styling, a scroll lock and a close button. Stacks without a z-index — the top layer is above every one of them.",
      "source": {
        "file": "../../src/dialog.svelte"
      },
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "bindable": true,
          "default": false
        },
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "dismissible",
          "type": "boolean",
          "default": true,
          "description": "Whether the caller may close it. False holds the dialog while an irreversible request is in flight — Escape, the backdrop and the close button go away together."
        },
        {
          "name": "class",
          "type": "string"
        },
        {
          "name": "children",
          "type": "Snippet",
          "required": true
        }
      ],
      "stories": [
        {
          "file": "../../src/dialog.stories.ts"
        }
      ]
    },
    {
      "id": "component.confirm-dialog",
      "type": "component",
      "name": "ConfirmDialog",
      "description": "A Dialog preset for the confirm-then-act flow that used to be window.confirm(): title, optional description, Cancel and confirm buttons. onConfirm may be async and may throw — the dialog holds itself non-dismissible and disables both buttons while it runs, then either closes (resolved) or shows the thrown message in place and re-enables (rejected).",
      "source": {
        "file": "../../src/confirm-dialog.svelte"
      },
      "props": [
        {
          "name": "open",
          "type": "boolean",
          "bindable": true,
          "default": false
        },
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "confirmLabel",
          "type": "string",
          "default": "Confirm"
        },
        {
          "name": "cancelLabel",
          "type": "string",
          "default": "Cancel"
        },
        {
          "name": "variant",
          "type": "ButtonVariant",
          "default": "primary",
          "description": "Passed straight to the confirm button. Reserve 'destructive' the way Button itself does — the action that destroys something and cannot be undone, not every removal."
        },
        {
          "name": "onConfirm",
          "type": "() => void | Promise<void>",
          "required": true
        },
        {
          "name": "children",
          "type": "Snippet"
        }
      ],
      "stories": [
        {
          "file": "../../src/confirm-dialog.stories.ts"
        }
      ]
    },
