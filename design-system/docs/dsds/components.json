{
  "$schema": "https://designsystemds.org/schema/component.json",
  "entities": [
    {
      "id": "component.button",
      "type": "component",
      "name": "Button",
      "description": "Action button with variant (primary/secondary/outline/ghost/destructive) and size (sm/md/lg/icon) props. Supports href for link rendering.",
      "source": {
        "file": "../../src/button.svelte"
      },
      "props": [
        {
          "name": "variant",
          "type": "ButtonVariant",
          "default": "secondary",
          "values": [
            "primary",
            "secondary",
            "outline",
            "ghost",
            "destructive"
          ],
          "description": "destructive is filled, for the action that cannot be undone; a ghost button with destructive text is the right weight for reversible ones."
        },
        {
          "name": "size",
          "type": "ButtonSize",
          "default": "md",
          "values": [
            "sm",
            "md",
            "lg",
            "icon"
          ]
        },
        {
          "name": "href",
          "type": "string",
          "default": "undefined",
          "description": "If set, renders an <a> instead of a <button>."
        },
        {
          "name": "class",
          "type": "string",
          "default": "undefined"
        },
        {
          "name": "children",
          "type": "Snippet",
          "required": true
        }
      ],
      "stories": [
        {
          "file": "../../src/button.stories.ts"
        },
        {
          "file": "../../src/button-icon.stories.ts"
        }
      ]
    },
