{
  "name": "freehire",
  "private": true,
  "description": "Repository root. The Go module is the product; web/, design-system/ and extension/ are their own packages with their own manifests. Only repo-wide tooling lives here.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "check:dead": "pnpm --dir web exec svelte-kit sync && knip",
    "check:deps": "node scripts/check-shared-deps.mjs",
    "check:links": "node scripts/check-doc-links.mjs",
    "check:size": "node scripts/check-file-size.mjs --all",
    "check:pr-title": "commitlint",
    "check:sql": "node scripts/check-migrations.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi": "^1.17.0",
    "@typespec/openapi3": "^1.17.0",
    "knip": "^6.33.0",
    "openapi-typescript": "^7.13.0",
    "squawk-cli": "^2.63.0"
  }
}
