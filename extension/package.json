{
  "name": "freehire-extension",
  "description": "Browser extension: a job-application agent side panel, on any page.",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "WXT_RELEASE=1 wxt zip",
