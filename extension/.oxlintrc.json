{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/no-unassigned-import": "off",
    // Every loop awaits in sequence on purpose: pagination, SSE reads, and a combobox
    // that must see one step settle before the next.
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      // A helper declared inside `describe`/`it` sits next to the tests that use it;
      // hoisting it to module scope would scatter each one away from its only reader.
      "files": ["**/*.{test,spec}.ts", "vitest.setup.ts"],
      "rules": { "unicorn/consistent-function-scoping": "off" }
    }
  ],
  "ignorePatterns": [".output", ".wxt", "node_modules"]
}
