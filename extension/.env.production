# Production build targets (`wxt build`). No secrets — just which deployment the
# extension talks to. `wxt dev` runs in development mode and ignores this file,
# falling back to the localhost default in lib/auth.ts.
#
# One origin is all there is: the chat, the browser-tool relay, autofill and the
# job reads are all hire.
WXT_HIRE_ORIGIN=https://freehire.me
