[Unit]
Description=timer: freehire-reindex-dedup-only

[Timer]
# Six times a day, OUTSIDE the 03:00-10:00 UTC block this host's other cron jobs already
# own: freehire-pg-backup (03:00, ~77min), freehire-rollup-facets (04:15),
# freehire-rollup-company (04:45), freehire-reindex-companies (05:15), and
# freehire-reindex-dedup itself (06:30, ~3.5h end to end, finishing ~08:25). That last one
# already refreshes the SAME three markers this timer refreshes, so skipping this slot
# costs nothing — the daily run covers it.
#
# Outside that block, firing every 3h (01:30, 10:30, 13:30, 16:30, 19:30, 22:30) is what
# actually shrinks the window: REINDEX_DEDUP=1 alone only refreshes markers once a day, so
# a repost could sit undeduped in search for up to a day (freehire#2045 — a Fivetran
# repost caught right in that window). The 3h spacing is a target, not a guarantee: the
# first real daytime run took 2h15m under normal concurrent load (see the service's
# TimeoutStartSec comment) against an 86min quiet-hours measurement, so some firings will
# land while the prior run is still active. That is a silent no-op, not a stack or a
# failure — Type=oneshot only starts a new instance if the unit isn't already active — and
# it self-throttles to roughly run-time-plus-next-slot rather than a fixed 3h, which is
# still a large improvement over the once-a-day floor this timer exists to beat.
#
# Persistent=true is safe here in a way it is explicitly NOT for
# freehire-reindex-dedup.timer (see that file's comment on the 2026-08-17 13:17 incident):
# this unit Conflicts= only with its own daily sibling, never with freehire-reindexw, so a
# missed firing catching up at an arbitrary hour cannot kill an in-progress rebuild.
#
# 2026-09-18: THE SLOTS ABOVE ARE WRONG, and the reasoning that chose them had one gap.
# It asked whether this unit could KILL a rebuild (it cannot — no Conflicts=) and never
# asked whether it could STARVE one. It can, and it did. `cmd/reindex`,
# `cmd/reindex-companies` and `cmd/build-suggestions` share ONE advisory lock, and the
# loser does not wait — it logs "another catalogue-wide index job is running" and exits 0,
# which is a green unit. This pass holds that lock for 2h13m-2h38m measured on 2026-09-18
# (13:30->16:09, 16:30->18:43), not the 2h15m-worst-case above, and the two slots at 01:30
# and 13:30 land exactly 1h45m before freehire-reindexw's 03:15 and 15:15 — inside the run,
# every single day. Both daily rebuilds had been skipping: the live jobs index was created
# 2026-09-15T16:29 and had not been rebuilt in the three days since, while search-drain's
# incremental pushes kept it looking healthy. A derived column is not in `content_hash`, so
# a dictionary fix reaches search ONLY through a rebuild; six skipped rebuilds is six
# dictionary fixes that silently never landed.
#
# The slots below keep the whole pass clear of both rebuild windows. A rebuild measured
# 4h15m at 4.5M documents (see freehire-reindexw.timer), so those windows are 03:15-07:30
# and 15:15-19:30; 12:30 (reindex-companies, ~10min) is avoided too, since it takes the
# same lock. Three firings rather than six is the real cost, and it is the right trade: a
# marker refreshed three times a day still beats the once-a-day floor this timer exists to
# beat, while six refreshes that cost every rebuild is a bad bargain at any freshness.
#
# What is NOT fixed here: freehire-build-suggestions at 06:45 falls inside the 03:15
# rebuild window and will now lose the lock to it, where before it always won because the
# rebuild never ran. It rebuilds daily and its own miss is cheap, but the whole heavy
# schedule wants laying out once against measured durations rather than patched per unit.
OnCalendar=*-*-* 08,20,23:00:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
