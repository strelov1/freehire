[Unit]
Description=timer: freehire-search-ping hourly
[Timer]
# Hourly, and the interval is about SPREADING the budget rather than reaching a deadline.
# Google's allowance is a fixed count per day, not a rate, so one run could spend all of
# it at 00:05 — but the postings worth announcing arrive all day (~14k new technical
# ones daily, measured 2026-09-14), and a batch sent at midnight can only ever contain
# what yesterday left behind. Twenty-four runs of the same day's allowance announce
# postings closer to when they appeared, which is the whole point of announcing at all.
OnBootSec=15min
OnUnitActiveSec=1h
# Persistent=false. A missed window is not work owed: the next run selects the newest
# eligible postings afresh, so replaying a skipped one on boot would announce the same
# batch the following run was going to choose anyway — and against a budget counted in
# hundreds a day, spending it twice on one hour's postings is the one avoidable waste.
Persistent=false
[Install]
WantedBy=timers.target
