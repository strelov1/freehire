[Unit]
Description=freehire worker: announce the newest job pages to external search engines
After=network.target postgresql.service
[Service]
Type=oneshot
User=freehire
WorkingDirectory=/opt/freehire/src/hire-current
EnvironmentFile=/opt/freehire/.env
# Low weights: this is a handful of HTTP calls against somebody else's API on a schedule,
# and must never be the reason a request waits. Google's default allowance is 200 URLs a
# DAY, so even a full run is a rounding error beside any crawl unit on this host.
CPUWeight=20
IOWeight=20
# A run with neither GOOGLE_INDEXING_KEY_FILE nor INDEXNOW_KEY exits 0 without opening
# the pool, so a host where this is not configured yet runs the timer harmlessly rather
# than failing every hour. That is also how the feature is rolled back: clear the two
# variables, and nothing is announced again.
#
# GOOGLE_INDEXING_KEY_FILE points at the service account key, which is NOT in git and
# NOT in .env — .env cannot hold a multi-line value. Put it on the host at
# /opt/freehire/secrets/indexing-sa.json, owned by freehire, mode 600.
ExecStart=/opt/freehire/src/hire-current/search-ping
