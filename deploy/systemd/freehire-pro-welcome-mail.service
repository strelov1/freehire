[Unit]
Description=freehire worker: welcome a newly-paying account with a one-time personal email
After=network.target postgresql.service
[Service]
Type=oneshot
User=freehire
WorkingDirectory=/opt/freehire/src/hire-current
EnvironmentFile=/opt/freehire/.env
# NOTIFY_EMAIL_FROM (and the SES keys) live ONLY in .env.notify — see deploy/AGENTS.md's
# "the environment is split across two files, and the split is a trap." A worker that
# sends mail and reads just the first loses its email channel silently (a deliberate
# soft-skip elsewhere becomes indistinguishable from a real outage here).
EnvironmentFile=/opt/freehire/.env.notify
# Low weights, for the reason freehire-discord-sync and freehire-billing-sync give:
# almost every run finds nothing to welcome, so it must never be why a request waits.
CPUWeight=20
IOWeight=20
# A run with no AWS_REGION/NOTIFY_EMAIL_FROM in the environment exits 0 without opening
# the pool, so a host where the mail transport is not provisioned runs this timer
# harmlessly. ONBOARDING_REPLY_TO missing is the one case that fails loudly (exit 1):
# this letter asks for a reply, and sending it with nowhere for that reply to land is
# worse than not sending it at all.
ExecStart=/opt/freehire/src/hire-current/pro-welcome-mail
