[Unit]
Description=freehire worker: re-derive every job's facets, fingerprint and slugs (run by hand)
# Re-derives every deterministic column (facets, role_fingerprint, slugs) over the whole
# jobs table. Run BY HAND after a dictionary change, then follow with
# REINDEX_DEDUP=1 make reindex -- there is deliberately NO timer beside this file.
#
# THERE USED TO BE ONE, AND IT COULD NOT WORK. A transient `taxonomy-backfill-night`
# unit (systemd-run, so in /run and in nobody's git) fired at 02:12 with
# TimeoutStartSec=10h. The pass over 12.7M rows needs longer than that, and before
# BACKFILL_DERIVE_FROM_ID existed it had no resume point at all -- so every night it ran
# ten hours from the first id, was killed about two thirds through, burned ~29h of CPU on
# an already-saturated host and derived nothing it kept. Five merged dictionary fixes
# waited on it. A schedule cannot own this pass, because systemd has nowhere to put the
# cursor between runs; an operator chains the runs and reads the id out of the log.
#
# Usage:
#   systemctl start freehire-backfill-derive            # unbounded, until it finishes
#   journalctl -u freehire-backfill-derive | tail       # `done`, or the id to continue at
#
# A run prints either `backfill-derive done` or an id to continue from. To chain bounded
# runs, or to resume after a stop, pass the knobs through a drop-in
# (systemctl edit freehire-backfill-derive) or run the binary directly:
#   systemd-run --uid=freehire --property=EnvironmentFile=/opt/freehire/.env \
#     -E BACKFILL_DERIVE_FROM_ID=<id> -E BACKFILL_DERIVE_MAX=<rows> \
#     /opt/freehire/src/hire-current/backfill-derive
After=network.target postgresql.service
[Service]
Type=oneshot
User=freehire
WorkingDirectory=/opt/freehire/src/hire-current
EnvironmentFile=/opt/freehire/.env
# Lowest share of a host whose bottleneck is the crawl fleet: this pass reads and
# de-TOASTs every description in the catalogue and will happily take everything it is
# given. BACKFILL_CONCURRENCY=6 has degraded prod before; the binary defaults to 1, and
# 2 measured 160 rows/s against 63 at 1.
CPUWeight=10
IOWeight=10
Environment=BACKFILL_CONCURRENCY=2
# No TimeoutStartSec. A stop is survivable -- the run prints the id to continue at, on
# the error path as well as the clean one -- but it is not free: whatever the reader had
# in flight is re-read, and a timeout firing unattended means nobody reads the id out of
# a journal that rotates faster than the pass runs. `infinity` makes the run's end an
# operator's decision.
TimeoutStartSec=infinity
ExecStart=/opt/freehire/src/hire-current/backfill-derive
