[Unit]
Description=freehire worker: publish the company name-to-domain map the logo proxy reads
# Postgres only. The consumer (freehire-logo) reads the file and is never talked to.
After=network.target postgresql.service

[Service]
Type=oneshot
User=freehire
WorkingDirectory=/opt/freehire/src/hire-current
EnvironmentFile=/opt/freehire/.env
# The one read that costs anything is a sequential scan of jobs, measured at 53s on
# 2026-09-16 (412,648 distinct company spellings across 12.8M rows). The host's
# bottleneck is the crawl fleet, so this yields to it.
CPUWeight=30
IOWeight=30
# The map must outlive a blue/green swap, so it lives outside the src tree — the same
# reason freehire-logo keeps its cache in /var/cache. StateDirectory creates
# /var/lib/freehire-logo-map on first start, owned by this unit's User; freehire-logo
# runs as the SAME user, so it can read the file without either unit owning the other's
# tree.
StateDirectory=freehire-logo-map
Environment=LOGO_DOMAIN_MAP_OUT=/var/lib/freehire-logo-map/domains.json
ExecStart=/opt/freehire/src/hire-current/publish-logo-domains
