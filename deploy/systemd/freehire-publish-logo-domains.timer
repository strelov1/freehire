[Unit]
Description=timer: freehire-publish-logo-domains

[Timer]
# Daily at 05:20 UTC. The slot yields to everything heavier: the 03:00 pg_dump runs
# 2h42m and clears around 05:42 — so this deliberately OVERLAPS its tail rather than
# waiting it out, because the two contend for I/O and not for locks (this worker takes
# none and writes no table), and every later slot collides with something that does.
# freehire-reindexw fires 03:15 and every 6h; build-suggestions takes 06:45.
OnCalendar=*-*-* 05:20:00
# Persistent, unlike build-suggestions beside it. Catch-up is safe here: nothing this
# worker does is order-dependent or collides with a serial queue — it reads, writes one
# file and exits — and a host that was down at 05:20 would otherwise serve yesterday's
# map for a full extra day.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
