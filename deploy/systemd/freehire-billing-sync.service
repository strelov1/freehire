[Unit]
Description=freehire worker: reconcile Pro subscriptions against the billing provider
After=network.target postgresql.service
[Service]
Type=oneshot
User=freehire
WorkingDirectory=/opt/freehire/src/hire-current
EnvironmentFile=/opt/freehire/.env
# Low weights: this worker repairs state that is already correct almost every run, so it
# must never be the reason a request waits. What it costs is one provider call per
# candidate, bounded by BILLING_SYNC_MAX_PER_RUN.
CPUWeight=20
IOWeight=20
# A run with no STRIPE_* in the environment exits 0 without opening the pool, so a
# host where billing is not configured yet runs this timer harmlessly rather than
# failing every hour.
ExecStart=/opt/freehire/src/hire-current/billing-sync
