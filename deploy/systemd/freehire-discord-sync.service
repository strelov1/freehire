[Unit]
Description=freehire worker: keep the paid Discord role in step with the subscription
After=network.target postgresql.service
[Service]
Type=oneshot
User=freehire
WorkingDirectory=/opt/freehire/src/hire-current
EnvironmentFile=/opt/freehire/.env
# Low weights, for the reason freehire-billing-sync gives: almost every run finds nothing
# to change, so it must never be why a request waits. What a run costs is one Discord call
# per account whose tier moved, bounded by DISCORD_SYNC_MAX_PER_RUN.
CPUWeight=20
IOWeight=20
# A run with no DISCORD_* in the environment exits 0 without opening the pool, so a host
# where the Discord application does not exist yet runs this timer harmlessly rather than
# failing every hour. That is also the rollback: unset DISCORD_BOT_TOKEN.
ExecStart=/opt/freehire/src/hire-current/discord-sync
