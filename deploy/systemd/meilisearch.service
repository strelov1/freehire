# The search engine. Recorded here because the host was the only copy of it until the
# 2026-09-14 memory-exhaustion outage went looking for its limits and found none.
#
# Nothing in this repository deploys it — see deploy/AGENTS.md. Copy it to
# /etc/systemd/system/ by hand, and `./deploy/check-drift.sh` reports when the two
# have moved apart.
[Unit]
Description=Meilisearch (freehire)
After=network.target

[Service]
User=freehire
WorkingDirectory=/var/lib/freehire/meili
EnvironmentFile=/opt/freehire/.env
ExecStart=/opt/freehire/bin/meilisearch --db-path /var/lib/freehire/meili --http-addr 127.0.0.1:7700 --env production
Restart=on-failure
RestartSec=2
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
