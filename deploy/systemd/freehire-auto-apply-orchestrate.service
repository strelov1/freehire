[Unit]
Description=freehire worker: auto-apply orchestrator (tailor -> await review -> review)
After=network-online.target freehire-inngest.service
Wants=network-online.target
Requires=freehire-inngest.service

[Service]
Type=simple
User=freehire
WorkingDirectory=/opt/freehire/src/hire-current
# AUTO_APPLY_ORCHESTRATOR_SECRET / INNGEST_EVENT_API_URL / INNGEST_EVENT_KEY /
# INNGEST_SIGNING_KEY live in this shared file like every other secret this fleet
# uses — no separate env file, unlike the mail-sending workers' own split (see
# deploy/AGENTS.md).
EnvironmentFile=/opt/freehire/.env
# HIRE_BASE_URL names the CURRENTLY-ACTIVE blue/green color's own API port — release.sh
# regenerates this file after every flip and restarts this unit right after, so a value
# here always matches whichever color is actually taking traffic. The `-` tolerates this
# file not existing yet (first provision, before release.sh has ever run). Without it,
# HireBaseURL falls back to internal/platform/config's own PORT default (8080), which
# matches neither blue (8081) nor green (8082) — found 2026-09-05 the hard way: every
# call this worker made failed with connection refused.
EnvironmentFile=-/opt/freehire/env/auto-apply-orchestrate.env
CPUWeight=40
IOWeight=40
# Long-lived: an Inngest function must stay reachable between steps for the SDK's
# own callback protocol, so this serves HTTP and blocks until SIGTERM — same shape
# as freehire-mail-ingest.service. Restart if it dies or loses its self-registration
# with freehire-inngest.service.
Restart=always
RestartSec=5
ExecStart=/opt/freehire/src/hire-current/auto-apply-orchestrate

[Install]
WantedBy=multi-user.target
