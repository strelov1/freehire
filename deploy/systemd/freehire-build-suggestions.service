[Unit]
Description=freehire worker: rebuild the search box's suggestion dictionary
# Needs Postgres (the titles and companies) and Meilisearch (the facet counts, and
# the dictionary index this writes).
After=network.target postgresql.service meilisearch.service
[Service]
Type=oneshot
User=freehire
WorkingDirectory=/opt/freehire/src/hire-current
EnvironmentFile=/opt/freehire/.env
CPUWeight=40
IOWeight=40
ExecStart=/opt/freehire/src/hire-current/build-suggestions
