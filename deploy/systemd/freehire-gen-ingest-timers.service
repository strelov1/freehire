[Unit]
Description=freehire: regenerate the per-provider ingest timers from the boards catalog
After=network.target postgresql.service

[Service]
Type=oneshot
# Root, unlike every other freehire worker: this one writes unit files into
# /etc/systemd/system and calls systemctl. It runs no ingest itself and touches no
# application data -- the only database statement it makes is the SELECT that reads the
# provider list.
User=root
# The script loads /opt/freehire/.env itself (it needs DATABASE_URL), so no EnvironmentFile
# here -- naming it twice would be a second answer to where the credentials come from.
ExecStart=/opt/freehire/bin/gen-ingest-timers.sh
# Long enough for ~300 systemctl calls on a loaded host, short enough that a wedged psql
# is a failed unit rather than a unit held open until the next firing.
TimeoutStartSec=600
CPUWeight=20
IOWeight=20

[Install]
WantedBy=multi-user.target
