{
  "openapi": "3.1.0",
  "info": {
    "title": "freehire API",
    "version": "0.0.0"
  },
  "tags": [
    {
      "name": "Email preferences"
    }
  ],
  "paths": {
    "/email-prefs": {
      "get": {
        "operationId": "getEmailPrefs",
        "parameters": [
          {
            "name": "t",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/EmailPrefs"
                    }
                  },
                  "description": "A single item: `{\"data\": ...}`."
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Email preferences"
        ]
      },
      "patch": {
        "operationId": "updateEmailPrefs",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/EmailPrefs"
                    }
                  },
                  "description": "A single item: `{\"data\": ...}`."
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Email preferences"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailPrefsTokenUpdate"
              }
            }
          }
        }
      }
    },
    "/email-prefs/one-click": {
      "post": {
        "operationId": "oneClickUnsubscribe",
        "description": "RFC 8058 one-click unsubscribe: turns off only the group the token names.",
        "parameters": [
          {
            "name": "t",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/OneClickResult"
                    }
                  },
                  "description": "A single item: `{\"data\": ...}`."
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Email preferences"
        ]
      }
    },
    "/me/email-groups": {
      "get": {
        "operationId": "getMyEmailGroups",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/EmailPrefs"
                    }
                  },
                  "description": "A single item: `{\"data\": ...}`."
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Email preferences"
        ]
      },
      "patch": {
        "operationId": "updateMyEmailGroups",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/EmailPrefs"
                    }
                  },
                  "description": "A single item: `{\"data\": ...}`."
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Email preferences"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailPrefsUpdate"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmailPrefs": {
        "type": "object",
        "required": [
          "email",
          "alerts_enabled",
          "activity_enabled",
          "news_enabled",
          "searches"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "alerts_enabled": {
            "type": "boolean"
          },
          "activity_enabled": {
            "type": "boolean"
          },
          "news_enabled": {
            "type": "boolean"
          },
          "searches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmailPrefsSearch"
            }
          }
        },
        "description": "The preference page's state: the address mail goes to and the three switches."
      },
      "EmailPrefsSearch": {
        "type": "object",
        "required": [
          "id",
          "name",
          "active"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        },
        "description": "One email digest subscription the switches govern."
      },
      "EmailPrefsTokenUpdate": {
        "type": "object",
        "properties": {
          "alerts_enabled": {
            "type": "boolean"
          },
          "activity_enabled": {
            "type": "boolean"
          },
          "news_enabled": {
            "type": "boolean"
          },
          "deactivate_searches": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "token": {
            "type": "string"
          }
        },
        "description": "The token-opened patch. The token rides in the body so it never reaches an access\nlog. Optional on the wire because a missing token must be refused exactly like a\nforged one (404), not with a 400 that tells the two apart."
      },
      "EmailPrefsUpdate": {
        "type": "object",
        "properties": {
          "alerts_enabled": {
            "type": "boolean"
          },
          "activity_enabled": {
            "type": "boolean"
          },
          "news_enabled": {
            "type": "boolean"
          },
          "deactivate_searches": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        "description": "A patch: an absent switch keeps its stored value. Searches can only be turned off."
      },
      "OneClickResult": {
        "type": "object",
        "required": [
          "unsubscribed_from",
          "manage_url"
        ],
        "properties": {
          "unsubscribed_from": {
            "type": "string"
          },
          "manage_url": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "description": "Every refusal, whatever its status: `{\"error\": msg}`. `code` is set only where a\nclient branches on the reason (the auth flows)."
      }
    }
  },
  "servers": [
    {
      "url": "https://freehire.me/api/v1",
      "description": "Production",
      "variables": {}
    }
  ]
}
