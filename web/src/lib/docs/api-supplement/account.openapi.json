    "/me/webhook": {
      "get": {
        "summary": "Your webhook destination for saved-search matches, or null if none is configured.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "url": "https://example.com/hook",
                    "enabled": true,
                    "created_at": "2026-09-04T12:00:00Z",
                    "last_success_at": null,
                    "disabled_at": null
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "CookieSession": []
          }
        ],
        "tags": [
          "Alerts"
        ]
      },
      "post": {
        "summary": "Create your webhook destination, or update its URL if one already exists.",
        "description": "There is exactly one destination per account. Deliveries are plain, unsigned HTTP POSTs — subscribe a saved search to the `webhook` channel (see `POST /me/subscriptions`) to receive its matches here. Before the URL is stored it receives a test delivery (`saved_search_name` \"freehire webhook test\", an empty `jobs` list); a URL that does not answer it with a 2xx is refused with 422, naming what it answered.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Destination URL — must be http or https.",
                    "example": "https://example.com/hook"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "url": "https://example.com/hook",
                    "enabled": true,
                    "created_at": "2026-09-04T12:00:00Z",
                    "last_success_at": null,
                    "disabled_at": null
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "CookieSession": []
          }
        ],
        "tags": [
          "Alerts"
        ]
      },
      "patch": {
        "summary": "Enable or disable your webhook destination without changing its URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "description": "Whether the destination is enabled.",
                    "example": "false"
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "url": "https://example.com/hook",
                    "enabled": false,
                    "created_at": "2026-09-04T12:00:00Z",
                    "last_success_at": null,
                    "disabled_at": "2026-09-04T13:00:00Z"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "CookieSession": []
          }
        ],
        "tags": [
          "Alerts"
        ]
      },
      "delete": {
        "summary": "Delete your webhook destination.",
        "responses": {
          "204": {
            "description": "No content"
          }
        },
        "security": [
          {
            "CookieSession": []
          }
        ],
        "tags": [
          "Alerts"
        ]
      }
    },
    "/me/webhook/test": {
      "post": {
        "summary": "Send a test delivery to your stored webhook destination.",
        "description": "The same sample delivery saving a URL sends. A 2xx answer stamps `last_success_at` and returns the destination; anything else is a 422 naming what the destination answered, and changes nothing. 404 when no destination is configured.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "url": "https://example.com/hook",
                    "enabled": true,
                    "created_at": "2026-09-04T12:00:00Z",
                    "last_success_at": "2026-09-04T13:00:00Z",
                    "disabled_at": null
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "CookieSession": []
          }
        ],
        "tags": [
          "Alerts"
        ]
      }
    },
    "/me/password": {
      "post": {
        "summary": "Change a known password.",
        "description": "Revokes every session; your own cookie is re-issued at the new generation, so you stay signed in and everyone else is signed out.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "current_password": {
                    "type": "string",
                    "description": "Your existing password."
                  },
                  "new_password": {
                    "type": "string",
                    "description": "The replacement."
                  }
                },
                "required": [
                  "current_password",
                  "new_password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "ok": true
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "CookieSession": []
          }
        ],
        "tags": [
          "Account"
        ]
      }
    },
    "/me": {
      "delete": {
        "summary": "Delete your account and everything under it.",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "CookieSession": []
          }
        ],
        "tags": [
          "Account"
        ]
      }
    },
    "/me/referrals/offers": {
      "post": {
        "summary": "Offer to refer into a company. Multipart — proof required.",
        "description": "The proof (an offer letter, badge, anything showing you work there) is stored privately and shown only to a moderator; its storage key is never exposed on the wire. The offer is pending until decided.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "company_slug": {
                    "type": "string",
                    "description": "The company you can refer into."
                  },
                  "linkedin_url": {
                    "type": "string",
                    "description": "Your profile, for the moderator to check against."
                  },
                  "proof": {
                    "type": "string",
                    "format": "binary",
                    "description": "Evidence you work there."
                  }
                },
                "required": [
                  "company_slug",
                  "proof"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "id": "b71e…",
                    "company_slug": "acme",
                    "company_name": "Acme",
                    "status": "pending",
                    "created_at": "2026-07-28T20:00:00Z"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "CookieSession": []
          },
          {
            "PersonalApiKey": []
          }
        ],
        "tags": [
          "Referrals"
        ]
      }
    },
