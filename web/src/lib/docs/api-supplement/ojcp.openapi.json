{
  "paths": {
    "/ojcp/v1/search": {
      "post": {
        "operationId": "ojcpSearchJobs",
        "tags": [
          "Jobs"
        ],
        "summary": "OJCP: search jobs",
        "description": "The `search_jobs` tool of the [Open Job Context Protocol](https://spec.ojcp.dev/) over REST: each result is an OJCP `JobPosting` with the paths it can be applied through. Discovery: `/.well-known/ojcp.json`; MCP: `/api/v1/ojcp/mcp`. A filter it cannot honour is named in `ignored_params`.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "An OJCP `search_jobs` input. Unrecognised fields are ignored rather than\nrefused, per the standard's extensibility rule.\n",
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "location": {
                    "type": "object",
                    "properties": {
                      "city": {
                        "type": "string"
                      },
                      "country": {
                        "type": "string"
                      },
                      "remote_ok": {
                        "type": "boolean"
                      }
                    }
                  },
                  "filters": {
                    "type": "object",
                    "properties": {
                      "employment_type": {
                        "type": "string"
                      },
                      "experience_level": {
                        "type": "string"
                      },
                      "salary_min": {
                        "type": "number"
                      },
                      "salary_max": {
                        "type": "number"
                      },
                      "posted_within_days": {
                        "type": "integer"
                      }
                    }
                  },
                  "pagination": {
                    "type": "object",
                    "properties": {
                      "limit": {
                        "type": "integer",
                        "maximum": 50,
                        "default": 10
                      },
                      "offset": {
                        "type": "integer",
                        "default": 0
                      }
                    }
                  },
                  "semantic": {
                    "type": "boolean",
                    "description": "Extension. `true` asks for meaning-based ranking, which is\ncurrently not available: the answer is the keyword search and\n`semantic` says `unavailable`. Without a non-empty `query` it is\nreported in `ignored_params` instead.\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An OJCP search-jobs response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ojcp_version",
                    "query",
                    "total_results",
                    "returned",
                    "offset",
                    "jobs"
                  ],
                  "properties": {
                    "ojcp_version": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    },
                    "total_results": {
                      "type": "integer"
                    },
                    "returned": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "jobs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "An OJCP JobPosting."
                      }
                    },
                    "ignored_params": {
                      "type": "array",
                      "description": "Input fields this provider could not honour.",
                      "items": {
                        "type": "string"
                      }
                    },
                    "semantic": {
                      "type": "string",
                      "enum": [
                        "applied",
                        "unavailable"
                      ],
                      "description": "Extension. Which search answered a request that sent\n`semantic: true`; omitted when it did not.\n"
                    },
                    "total_is_lower_bound": {
                      "type": "boolean",
                      "description": "Extension. True when `total_results` is a minimum (what this\npage reaches, plus one when there is a next page), not a count\nof the match.\n"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "OJCP error `invalid_request`: the body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ojcp_version",
                    "error_code",
                    "message"
                  ],
                  "properties": {
                    "ojcp_version": {
                      "type": "string"
                    },
                    "error_code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "OJCP error `provider_error`: search is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ojcp_version",
                    "error_code",
                    "message"
                  ],
                  "properties": {
                    "ojcp_version": {
                      "type": "string"
                    },
                    "error_code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/ojcp/v1/jobs/{slug}": {
      "get": {
        "operationId": "ojcpJobDetail",
        "tags": [
          "Jobs"
        ],
        "summary": "OJCP: read one posting",
        "description": "The `get_job_detail` tool, by the `ojcp_id` a search result carries.\n",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The posting's ojcp_id (its public_slug)."
          }
        ],
        "responses": {
          "200": {
            "description": "An OJCP job-detail response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ojcp_version",
                    "job"
                  ],
                  "properties": {
                    "ojcp_version": {
                      "type": "string"
                    },
                    "job": {
                      "type": "object",
                      "description": "An OJCP JobPosting."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "OJCP error `job_not_found`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ojcp_version",
                    "error_code",
                    "message"
                  ],
                  "properties": {
                    "ojcp_version": {
                      "type": "string"
                    },
                    "error_code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/ojcp/v1/employers/{slug}": {
      "get": {
        "operationId": "ojcpEmployerContext",
        "tags": [
          "Companies"
        ],
        "summary": "OJCP: read an employer",
        "description": "The `get_employer_context` tool, by the `ojcp_employer_id` a posting carries.\nIncludes `open_roles_count`, the one figure a single posting cannot state.\n",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The employer's ojcp_employer_id (its company slug)."
          }
        ],
        "responses": {
          "200": {
            "description": "An OJCP employer-context response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ojcp_version",
                    "employer_id",
                    "name"
                  ],
                  "properties": {
                    "ojcp_version": {
                      "type": "string"
                    },
                    "employer_id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "industries": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "open_roles_count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "OJCP error `employer_not_found`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ojcp_version",
                    "error_code",
                    "message"
                  ],
                  "properties": {
                    "ojcp_version": {
                      "type": "string"
                    },
                    "error_code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    }
  }
}
