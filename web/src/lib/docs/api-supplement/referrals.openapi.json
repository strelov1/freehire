{
  "paths": {
    "/me/referrals/offers": {
      "post": {
        "summary": "Offer to refer into a company. Multipart — proof required.",
        "description": "The proof (an offer letter, badge, anything showing you work there) is stored privately and shown only to a moderator; its storage key is never exposed on the wire. The offer is pending until decided.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "company_slug": {
                    "type": "string",
                    "description": "The company you can refer into."
                  },
                  "linkedin_url": {
                    "type": "string",
                    "description": "Your profile, for the moderator to check against."
                  },
                  "proof": {
                    "type": "string",
                    "format": "binary",
                    "description": "Evidence you work there."
                  }
                },
                "required": [
                  "company_slug",
                  "proof"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "id": "b71e…",
                    "company_slug": "acme",
                    "company_name": "Acme",
                    "status": "pending",
                    "created_at": "2026-07-28T20:00:00Z"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "CookieSession": []
          },
          {
            "PersonalApiKey": []
          }
        ],
        "tags": [
          "Referrals"
        ]
      }
    },
    "/me/referrals/incoming/{id}/cv": {
      "get": {
        "summary": "View the candidate's CV for one incoming request.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The request id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "CookieSession": []
          },
          {
            "PersonalApiKey": []
          }
        ],
        "tags": [
          "Referrals"
        ]
      }
    },
    "/referrals/offers/{id}/proof": {
      "get": {
        "summary": "View an offer's proof document.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The offer id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "CookieSession": []
          }
        ],
        "tags": [
          "Referrals"
        ],
        "x-audience": "moderator"
      }
    }
  }
}
