{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/no-unassigned-import": "off",
    // Pushes `.sort()` towards `.toSorted()`, which is the wrong direction for a
    // browser bundle: Safari only grew the copying methods in 16.4, they are runtime
    // methods no build target can transpile, and a throw during module init takes the
    // page down rather than the one list. eslint.config.js bans them outright; leaving
    // this on would have the two linters argue over every sort. Revisit together.
    "unicorn/no-array-sort": "off",
    // Same conflict as above for `.reverse()` and `.toReversed()`.
    "unicorn/no-array-reverse": "off",
    // Every loop we have awaits in sequence on purpose: pages whose cursor comes from the
    // previous one, backoff polls, SSE reads, and test or e2e steps that must run in order.
    "no-await-in-loop": "off",
    // The spread-in-`map` copies are over short view lists (tabs, chips, a card's rows),
    // and the rewrite the rule asks for (`Object.assign`, or mutating) reads worse.
    "oxc/no-map-spread": "off"
  },
  "overrides": [
    {
      // A helper declared inside `describe`/`it` sits next to the tests that use it;
      // hoisting it to module scope would scatter each one away from its only reader.
      "files": ["**/*.{test,spec}.{ts,mjs}", "vitest.setup.ts"],
      "rules": { "unicorn/consistent-function-scoping": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
