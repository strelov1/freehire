{
  "name": "freehire-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web frontend for the freehire job aggregator.",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && pnpm test:cluster",
    "test:coverage": "vitest run --coverage && pnpm test:cluster",
    "test:cluster": "node --test scripts/cluster-smoke.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "og:smoke": "node scripts/og-smoke.mjs",
    "og:gen": "node scripts/gen-og.mjs",
    "gen:api-docs": "node scripts/gen-api-docs.mjs",
    "gen:api-docs:smoke": "node scripts/gen-api-docs-smoke.mjs",
    "gen:collection-stacks": "svelte-kit sync && node scripts/build-collection-stacks.mjs",
    "size": "size-limit",
    "lint": "oxlint --deny-warnings && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.66.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^1.77.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "mdsvex": "^0.12.8",
    "oxfmt": "0.77.0",
    "oxlint": "^1.77.0",
    "size-limit": "^14.3.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.5",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.9.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/api-reference": "1.76.4",
    "@scalar/server-side-rendering": "0.1.66",
    "@scalar/types": "0.26.0",
    "easymde": "^2.21.0",
    "flag-icons": "^7.5.0",
    "freehire-design-system": "link:../design-system",
    "isomorphic-dompurify": "^4.6.0",
    "marked": "^18.1.2",
    "posthog-js": "^1.444.3",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "simple-icons": "^16.36.0",
    "svelte-dnd-action": "^0.9.80",
    "three": "^0.187.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
