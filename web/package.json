{
  "name": "freehire-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web frontend for the freehire job aggregator.",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "og:smoke": "node scripts/og-smoke.mjs",
    "og:gen": "node scripts/gen-og.mjs",
    "pwa:icons": "node scripts/gen-pwa-icons.mjs",
    "gen:api-docs": "node scripts/gen-api-docs.mjs",
    "gen:api-docs:smoke": "node scripts/gen-api-docs-smoke.mjs",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.25.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.2.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^1.77.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "mdsvex": "^0.12.8",
    "oxlint": "^1.77.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "svelte-eslint-parser": "^1.8.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.6.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/sveltekit": "^10.69.0",
    "easymde": "^2.21.0",
    "flag-icons": "^7.5.0",
    "isomorphic-dompurify": "^3.22.0",
    "marked": "^18.0.9",
    "posthog-js": "^1.414.0",
    "satori": "^0.29.0",
    "satori-html": "^0.3.2",
    "shiki": "^4.4.2",
    "svelte-dnd-action": "^0.9.78",
    "workbox-window": "^7.4.1",
    "freehire-design-system": "link:../design-system"
  }
}
