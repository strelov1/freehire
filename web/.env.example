# --- Dev ---
# Backend the dev server proxies /api and /health to (keeps dev same-origin).
VITE_API_URL=http://localhost:8080

# --- Production (adapter-node server) ---
# Public origin of the site. REQUIRED in prod: behind nginx the Node server binds
# to a local port, so without this `url.origin` (used for canonical tags, og:url,
# JSON-LD urls and the sitemap <loc>s) would be an internal host. Alternatively set
# PROTOCOL_HEADER=x-forwarded-proto + HOST_HEADER=x-forwarded-host and have nginx
# forward them.
# ORIGIN=https://freehire.me

# Internal origin the SSR server fetches the Go API from, server-to-server. A
# relative /api would hit this Node server, not the backend. Empty in dev (the
# Vite proxy handles it).
# API_INTERNAL_URL=http://app:8080

# Reveals the "Open within" bound — how long a posting has been in the catalogue, as
# opposed to the date its source states. Default OFF. It also decides which of the two
# the select above the list writes: with this on it bounds the open date and reads
# "Open", with it off it bounds the source date and reads "Posted" exactly as before.
#
# Dark for the same shape of reason as the match sort, one step further along. The API
# honours `?open_within_days` the moment the binary is out, but it filters on a
# `created_ts` field that only a FULL Meilisearch rebuild writes into the documents
# already in the index — the incremental drain pushes only documents whose content_hash
# moved, and this field is not in that hash. Before the rebuild the bound matches almost
# nothing: a thin feed, not an error, so nothing alerts.
#
# So: patch the live index settings, deploy, run the rebuild, verify by hand with
# `?open_within_days=3` (the param is honoured whether or not this flag is set), then
# set this and restart the web server.
# PUBLIC_OPEN_WITHIN=1
